# Provider URLs and bounded HTTP behavior
DICTIONARY_API_URL=https://api.dictionaryapi.dev/api/v2/entries/en/
DATAMUSE_API_URL=https://api.datamuse.com/words
DATAMUSE_SUGGEST_URL=https://api.datamuse.com/sug
# Set DATAMUSE_VOCABULARY=es for Datamuse's Spanish vocabulary.
# DATAMUSE_VOCABULARY=es
PROVIDER_TIMEOUT_SECONDS=5
PROVIDER_RETRIES=1
# DATAMUSE_API_KEY=

# Choose memory, sqlite, or none
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=300
SQLITE_CACHE_PATH=dictionary-cache.sqlite3
VOCABULARY_DB_PATH=dictionary-vocabulary.sqlite3

# Optional local data (not bundled)
# WORD_CORPUS_PATH=./data/words.tsv
# OFFLINE_DICTIONARY_PATH=./data/dictionary.jsonl
MAX_BATCH_SIZE=50
